/*
 * Generated at CMake configure time from the EB_UPDATER_TOKEN cache
 * variable. NEVER committed -- lives only in the build tree (see
 * port/unix/CMakeLists.txt), and included by exactly one translation unit
 * (platform/sdl2_updater.c). Deliberately NOT passed as a
 * target_compile_definitions -- that would land the token in every TU's
 * command line in compile_commands.json, a real leak vector (that file
 * gets copied into IDE configs and shared build caches more often than
 * expected) for no benefit over this generated-header approach.
 */
#ifndef EB_UPDATER_SECRET_H
#define EB_UPDATER_SECRET_H

#define EB_UPDATER_REPO_STRING "@EB_UPDATER_REPO@"
#define EB_UPDATER_TOKEN_STRING "@EB_UPDATER_TOKEN@"

#endif /* EB_UPDATER_SECRET_H */
