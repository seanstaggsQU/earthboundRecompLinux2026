# Self-update backend's generated PAT header (port/unix/CMakeLists.txt
# configure_file()'s output). Already covered by the build-dir patterns
# above in the normal case; listed explicitly too as defense-in-depth in
# case CMAKE_CURRENT_BINARY_DIR is ever pointed somewhere those don't
# match -- this file is the one place a real secret could land on disk.
updater_secret.h
